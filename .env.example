DATABASE_URL="postgresql://postgres:postgres@localhost:5432/harborview?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV="development"
# Optional sandbox adapter: set to "mock" to enable simulated payment intent confirmation.
PAYMENT_PROVIDER="mock"
# Leave unset to use the clearly labeled sample dashboard.
# When a compatible Flask resume analyzer is available, set its origin here.
VITE_RESUME_API_URL=http://localhost:5000
# The configured service should accept POST multipart/form-data with a "resume" file.
# Override this when the Flask analyzer uses a different analysis route.
VITE_RESUME_ANALYZE_PATH=/analyze